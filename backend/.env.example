OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
DATABASE_URL=postgresql://username:password@localhost:5432/dependency_graph
PORT=5000
LLM_CONNECT_TIMEOUT=30
LLM_READ_TIMEOUT=1800
LLM_WRITE_TIMEOUT=60
LLM_POOL_TIMEOUT=60
ANALYSIS_TIMEOUT_SECONDS=3600
LLM_JSON_REPAIR_ATTEMPTS=1
LLM_GRAPH_RETRY_ATTEMPTS=1